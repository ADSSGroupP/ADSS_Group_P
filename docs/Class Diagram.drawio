        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam packageStyle rectangle\nskinparam linetype ortho\n\nskinparam DefaultFontSize 14\nskinparam ClassFontSize 16\nskinparam ArrowFontSize 14\n\npackage PresentationLayer {\n class Main {\n + {static} main(args: String[]): void\n }\n\n class UserInterface {\n + start(): void\n - handleHRChoice(choice: int): void\n - managerMenu(): void\n - employeeMenu(): void\n - editConstraints(emp: Employee): void\n }\n \n Main ..&gt; UserInterface : \&quot;creates &amp; starts\&quot; &gt;\n}\n\npackage DomainLayer {\n\n class Branch {\n ~ int branch_id\n ~ String location\n }\n\n class Employee {\n - String name\n - int id\n - double salary\n - int bank_num\n - int branch_num\n - int account_num\n - Boolean is_shift_manager\n - DayOfWeek day_off\n - int branch_id\n + Employee(...)\n + setIs_shift_manager()\n + addConstraint(c: Constraint)\n + getIs_shift_manager(): boolean\n }\n\n class Driver {\n - String license\n + Driver(...)\n + getLicense(): String\n }\n\n class Constraint {\n - int employee_ID\n ~ LocalDate date\n - LocalTime start\n - LocalTime end\n - Boolean double_shift\n - int extra_hours\n - boolean isChangeable\n + Constraint(ID, date, start, end, double_shift, extra_hours, isChangeable)\n + overlapsWith(start, end): boolean\n + blocksMorningShift(): boolean\n + blocksEveningShift(): boolean\n }\n\n class JobTerms {\n - LocalDate start_date\n - String job_scope\n - double global_wage\n - double hourly_wage\n + JobTerms(startDate, scope, global, hourly)\n }\n\n class Shift {\n ~ LocalDate date\n - char type\n - int branch_id\n + setShift_model(role, amount)\n + setShift_roles(employee, role)\n + addExtraHoursAssignment(e, hours)\n }\n\n class ShiftAssignment {\n - Map&lt;Employee, Role&gt; shift_roles\n - Map&lt;Integer, Driver&gt; shift_transportation\n + assign(e, role)\n + assignDriverToTransport(id, driver)\n }\n\n class StaffingRequirement {\n - Map&lt;Role, Integer&gt; shift_model\n + setRequirement(role, amount)\n }\n\n class PersonnelManager {\n - String username\n - String password\n - int branch_id\n + authenticate(pass): boolean\n }\n\n enum Role {\n CASHIER\n STOREKEEPER\n DRIVER\n SHIFTMANAGER\n }\n\n interface HRRepository {\n + getEmployeeById(id: int): Employee\n + saveEmployee(emp: Employee): void\n + getShiftByDateAndType(d: LocalDate, t: char): Shift\n + saveShift(s: Shift): void\n }\n\n class HRRepositoryImpl\n\n &#39; Relationships\n Employee &lt;|-- Driver\n Employee \&quot;1\&quot; *-- \&quot;1\&quot; JobTerms\n Employee \&quot;1\&quot; *-- \&quot;0..*\&quot; Constraint\n Shift \&quot;1\&quot; *-- \&quot;1\&quot; StaffingRequirement\n Shift \&quot;1\&quot; *-- \&quot;1\&quot; ShiftAssignment\n\n &#39; Branch Connections\n Branch \&quot;1\&quot; &lt;-- \&quot;1..*\&quot; Employee : \&quot;belongs to\&quot;\n Branch \&quot;1\&quot; &lt;-- \&quot;1..*\&quot; Shift : \&quot;hosted at\&quot;\n Branch \&quot;1\&quot; &lt;-- \&quot;1\&quot; PersonnelManager : \&quot;manages\&quot;\n \n HRRepositoryImpl ..|&gt; HRRepository\n}\n\npackage ServiceLayer {\n class EmployeeService {\n - List&lt;Employee&gt; employees\n - List&lt;Employee&gt; firedEmployees\n - LocalDateTime constraintDeadline\n + addEmployee(emp)\n + fireEmployee(id)\n + checkLicence(id): boolean\n + isDeadlinePassed(): boolean\n + editConstraint(employeeId, dateToEdit, updatedConstraint): String\n }\n\n class ShiftService {\n - List&lt;Shift&gt; shiftHistory\n + assignEmployeeToShift(...)\\n + createDefaultShift(...)\\n + findShiftByDateAndType(date, type): Shift\n }\n\n EmployeeService \&quot;1\&quot; o-- \&quot;1..*\&quot; Employee\n ShiftService \&quot;1\&quot; o-- \&quot;1..*\&quot; Shift\n ShiftService ..&gt; EmployeeService : \&quot;uses\&quot;\n \n EmployeeService \&quot;1\&quot; --&gt; \&quot;1\&quot; HRRepository : \&quot;invokes\&quot;\n ShiftService \&quot;1\&quot; --&gt; \&quot;1\&quot; HRRepository : \&quot;invokes\&quot;\n}\n\npackage DataAccessLayer {\n class Database {\n - {static} CONNECTION_URL: String\n + {static} getConnection(): Connection\n }\n\n interface EmployeeDAO {\n + findById(id: int): EmployeeDTO\n + save(dto: EmployeeDTO): void\n }\n \n interface ShiftDAO {\n + findByDate(d: LocalDate, t: char): ShiftDTO\n + save(dto: ShiftDTO): void\n }\n\n interface ConstraintDAO {\n + findByEmployeeId(id: int): List&lt;ConstraintDTO&gt;\\n + save(dto: ConstraintDTO): void\n }\n\n class JdbcEmployeeDAO\n class JdbcConstraintDAO\n class JdbcShiftDAO\n \n HRRepositoryImpl \&quot;1\&quot; --&gt; \&quot;1\&quot; EmployeeDAO\n HRRepositoryImpl \&quot;1\&quot; --&gt; \&quot;1\&quot; ShiftDAO\n HRRepositoryImpl \&quot;1\&quot; --&gt; \&quot;1\&quot; ConstraintDAO\n \n JdbcEmployeeDAO ..|&gt; EmployeeDAO\n JdbcConstraintDAO ..|&gt; ConstraintDAO\n JdbcShiftDAO ..|&gt; ShiftDAO\n\n JdbcEmployeeDAO ..&gt; Database : \&quot;uses\&quot;\n JdbcConstraintDAO ..&gt; Database : \&quot;uses\&quot;\n JdbcShiftDAO ..&gt; Database : \&quot;uses\&quot;\n}\n\npackage DTOLayer {\n class EmployeeDTO &lt;&lt;DTO&gt;&gt; {\n + id: int\n + name: String\n + is_shift_manager: boolean\n }\n\n class ShiftDTO &lt;&lt;DTO&gt;&gt; {\n + date: LocalDate\n + type: char\n + managerId: int\n }\n\n class ConstraintDTO &lt;&lt;DTO&gt;&gt; {\n + employeeId: int\n + date: LocalDate\n + start: LocalTime\n + end: LocalTime\n }\n}\n\n&#39; קשרי העברת נתונים בין ה-DAO ל-DTO בתיקייה הנפרדת\nEmployeeDAO ..&gt; EmployeeDTO : \&quot;transfers\&quot;\nShiftDAO ..&gt; ShiftDTO : \&quot;transfers\&quot;\nConstraintDAO ..&gt; ConstraintDTO : \&quot;transfers\&quot;\n\n&#39; Global UI Connections\nUserInterface ..&gt; EmployeeService\nUserInterface ..&gt; ShiftService\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="BxqX859hPyoxS0rSs8kH-81">
